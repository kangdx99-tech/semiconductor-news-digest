# ─────────────────────────────────────────────────────────────
# 复制成 .env 再填。这个文件会被 .gitignore 忽略，不会被提交。
# 需要填哪些，取决于你开了哪些推送渠道 —— 只用 local_md 的话一个都不用填。
# ─────────────────────────────────────────────────────────────

# 【大模型】OpenAI 兼容接口都行（DeepSeek / OpenAI / OpenRouter / Kimi / 本地 vLLM…）
# 变量名要和 config.yaml 里的 llm.api_key_env 保持一致
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# MOONSHOT_API_KEY=

# 【飞书】开发者后台 → 凭证与基础信息
# 需要开通的权限：docx:document（云文档读写）、im:message（发消息）
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 【Telegram】@BotFather 拿 bot token；chat_id 可以用 @userinfobot 查
TELEGRAM_BOT_TOKEN=

# 【邮件推送】
SMTP_USER=
SMTP_PASS=
